{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EpicBlackWolfZ/capagent/schema/v1/schema.json",
  "title": "CapagentReportV1",
  "description": "Authoritative machine-readable report format for container host compatibility evaluations (Schema v1).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "context",
    "host",
    "runtimes",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Canonical schema major version integer (fixed to 1 for Schema v1)."
    },
    "context": {
      "type": "object",
      "description": "Evaluation execution context summarizing target user identity and environment boundaries.",
      "additionalProperties": true,
      "required": [
        "uid",
        "gid",
        "target_user",
        "is_rootless",
        "in_container"
      ],
      "properties": {
        "uid": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Target Linux User ID (UID) under which capability evaluations are assessed.",
          "minimum": 0,
          "maximum": 4294967295
        },
        "gid": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Target Linux Group ID (GID) under which capability evaluations are assessed.",
          "minimum": 0,
          "maximum": 4294967295
        },
        "target_user": {
          "type": "string",
          "description": "Target Linux username for deployment."
        },
        "is_rootless": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether evaluations execute under non-root unprivileged namespace constraints."
        },
        "in_container": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the evaluation environment is itself running within an outer container."
        },
        "completeness": {
          "$ref": "#/$defs/completeness"
        }
      }
    },
    "host": {
      "type": "object",
      "description": "Observed host-level kernel, distribution, cgroup, and init system facts.",
      "additionalProperties": true,
      "required": [
        "os",
        "os_version",
        "kernel",
        "architecture",
        "cgroup_version",
        "systemd"
      ],
      "properties": {
        "os": {
          "type": "string",
          "description": "Normalized operating system ID (e.g. rhel, fedora, ubuntu, debian, alpine)."
        },
        "os_version": {
          "type": "string",
          "description": "Operating system release version string."
        },
        "kernel": {
          "type": "string",
          "description": "Operating system kernel release string (uname -r)."
        },
        "architecture": {
          "type": "string",
          "description": "Observed machine normalized to amd64/arm64 where recognized; original value is retained in kernel observation."
        },
        "cgroup_version": {
          "type": "string",
          "enum": [
            "v1",
            "v2",
            "mixed",
            "unavailable",
            "unknown"
          ],
          "description": "Cgroup hierarchy operational mode on the host."
        },
        "systemd": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether systemd init is active as PID 1 on the host."
        },
        "completeness": {
          "$ref": "#/$defs/completeness"
        }
      }
    },
    "runtimes": {
      "type": "object",
      "description": "Observed container runtimes discovered on the host environment.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "installed": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether a regular executable candidate exists at the explicitly selected path or in the documented fixed search locations."
          },
          "version": {
            "type": "string",
            "description": "Reported version string of the runtime."
          },
          "accessible": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the selected runtime inspection succeeded for this evaluation scope; null means unobserved."
          },
          "network_backend": {
            "type": "string",
            "description": "Configured network backend driver (e.g. netavark, cni)."
          },
          "storage_driver": {
            "type": "string",
            "description": "Active graph/storage driver (e.g. overlay, overlay2, vfs, btrfs, zfs)."
          },
          "completeness": {
            "$ref": "#/$defs/completeness"
          },
          "path": {
            "type": "string",
            "pattern": "^/",
            "description": "Selected executable path; a missing explicit override remains visible."
          },
          "cli_runnable": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Selected CLI returned a recognizable version, independently of engine accessibility. Absent or null means unobserved."
          },
          "file": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "regular": {
                "type": "boolean"
              },
              "executable_bits": {
                "type": "boolean"
              },
              "mode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 511
              },
              "uid": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 4294967295
              },
              "gid": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "required": [
              "regular",
              "executable_bits",
              "mode",
              "uid",
              "gid"
            ]
          },
          "version_details": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "major": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "minor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "patch": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "canonical": {
                "type": "string"
              },
              "suffix": {
                "type": "string"
              },
              "build": {
                "type": "string"
              },
              "trailing": {
                "type": "string"
              },
              "raw": {
                "type": "string"
              }
            },
            "required": [
              "major",
              "minor",
              "patch",
              "canonical",
              "raw"
            ]
          },
          "rootless": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Runtime-reported rootless mode; false is an observed rootful value and absence/null is unknown."
          },
          "cgroup_version": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_.+-]*$",
            "description": "Effective runtime metadata; this is not a direct host or workload capability measurement."
          },
          "cgroup_manager": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_.+-]*$",
            "description": "Effective runtime metadata; this is not a direct host or workload capability measurement."
          },
          "graph_root": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096,
            "pattern": "^(/|$)",
            "description": "Sanitized effective storage path; empty is preserved and absence/null is unknown. No write test is implied."
          },
          "run_root": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096,
            "pattern": "^(/|$)",
            "description": "Sanitized effective storage path; empty is preserved and absence/null is unknown. No write test is implied."
          },
          "oci_runtime": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_.+-]{0,128}$"
              },
              "path": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Evaluated canonical capabilities mapped to operational state, confidence, and evidence.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "state",
          "confidence",
          "evidence"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "supported",
              "unsupported",
              "misconfigured",
              "unavailable",
              "unknown"
            ],
            "description": "Authoritative operational capability state."
          },
          "confidence": {
            "type": "string",
            "enum": [
              "verified",
              "derived",
              "heuristic",
              "unknown"
            ],
            "description": "Degree of confidence in capability determination based on evidence hierarchy."
          },
          "reason": {
            "type": "string",
            "description": "Human-readable diagnostic reason explaining determination or root cause."
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Deterministic list of supporting evidence identifiers."
          },
          "superseded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "propertyNames": {
        "pattern": "^(host|runtime|container|image|network|storage|systemd|context)(\\.[a-z0-9_]+)+$"
      }
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    }
  },
  "$defs": {
    "completeness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unobserved"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "context_id",
        "runtime",
        "endpoint"
      ],
      "oneOf": [
        {
          "properties": {
            "runtime": {
              "const": ""
            },
            "endpoint": {
              "const": ""
            }
          }
        },
        {
          "properties": {
            "runtime": {
              "minLength": 1
            },
            "endpoint": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "identity": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "uid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "gid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "supplementary_groups": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "groups_known": {
              "type": "boolean"
            }
          },
          "required": [
            "uid",
            "gid",
            "supplementary_groups",
            "groups_known"
          ]
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "namespace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "completeness": {
          "$ref": "#/$defs/completeness"
        }
      },
      "required": [
        "id",
        "source",
        "timestamp",
        "completeness"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "probe_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "completeness": {
          "$ref": "#/$defs/completeness"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "host": {
          "$ref": "#/$defs/host_observation"
        },
        "authority": {
          "enum": [
            "current",
            "execution"
          ]
        },
        "identity": {
          "type": "object",
          "properties": {
            "selection": {
              "type": "string"
            },
            "account_source": {
              "const": "local-files"
            },
            "groups_source": {
              "enum": [
                "kernel",
                "local-files"
              ]
            },
            "resolved": {
              "type": "boolean"
            }
          },
          "required": [
            "selection",
            "account_source",
            "groups_source",
            "resolved"
          ],
          "additionalProperties": false
        },
        "subids": {
          "$ref": "#/$defs/subIDs"
        },
        "user_context": {
          "$ref": "#/$defs/userContext"
        },
        "executable": {
          "$ref": "#/$defs/executable_observation"
        },
        "quadlet": {
          "$ref": "#/$defs/quadlet_observation"
        }
      },
      "required": [
        "id",
        "probe_id",
        "scope",
        "timestamp",
        "completeness",
        "facts",
        "diagnostics"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "pattern": "^(host|runtime|container|image|network|storage|systemd|context)(\\.[a-z0-9_]+)+$",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "completeness": {
          "$ref": "#/$defs/completeness"
        },
        "precedence": {
          "type": "string",
          "enum": [
            "live",
            "runtime",
            "config",
            "knowledge",
            "heuristic"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "supported",
            "unsupported",
            "misconfigured",
            "unavailable",
            "unknown"
          ],
          "description": "Authoritative operational capability state."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "verified",
            "derived",
            "heuristic",
            "unknown"
          ],
          "description": "Degree of confidence in capability determination based on evidence hierarchy."
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "source",
        "claim",
        "scope",
        "timestamp",
        "completeness",
        "precedence",
        "state",
        "confidence",
        "observations",
        "depends_on"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "SATISFIED",
            "UNSATISFIED",
            "INDETERMINATE"
          ]
        },
        "reason": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      },
      "required": [
        "state",
        "reason",
        "diagnostics",
        "children"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "enum": [
            "fixture",
            "live"
          ]
        },
        "provenance": {
          "type": "string",
          "enum": [
            "captured",
            "synthetic",
            "live"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "current": {
          "$ref": "#/$defs/identity"
        },
        "target": {
          "$ref": "#/$defs/identity"
        },
        "namespaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namespace"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "requirement": {
          "$ref": "#/$defs/requirement"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "collection": {
          "enum": [
            "passive",
            "active"
          ],
          "description": "Explicit live collection policy. Active permits the bounded user-manager query and reviewed Podman inspection effects."
        },
        "execution": {
          "$ref": "#/$defs/identity"
        },
        "selection": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "provenance",
        "scope",
        "timestamp",
        "current",
        "target",
        "namespaces",
        "observations",
        "evidence",
        "diagnostics"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "live"
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "const": "live"
              }
            }
          },
          "else": {
            "properties": {
              "provenance": {
                "enum": [
                  "synthetic",
                  "captured"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "mode": {
                "const": "live"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "properties": {
                  "runtime": {
                    "const": ""
                  }
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "requirement"
              ]
            }
          },
          "else": {
            "required": [
              "requirement"
            ]
          }
        }
      ]
    },
    "host_observation": {
      "type": "object",
      "properties": {
        "os": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 4096
            },
            "version_id": {
              "type": "string",
              "maxLength": 4096
            },
            "name": {
              "type": "string",
              "maxLength": 4096
            },
            "pretty_name": {
              "type": "string",
              "maxLength": 4096
            },
            "variant": {
              "type": "string",
              "maxLength": 4096
            },
            "id_like": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          },
          "additionalProperties": false
        },
        "kernel": {
          "type": "object",
          "properties": {
            "release": {
              "type": "string",
              "maxLength": 4096
            },
            "version": {
              "type": "string",
              "maxLength": 4096
            },
            "machine": {
              "type": "string",
              "maxLength": 4096
            },
            "architecture": {
              "type": "string",
              "maxLength": 4096
            },
            "parts": {
              "type": "object",
              "properties": {
                "major": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "minor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "patch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "systemd": {
          "type": "object",
          "properties": {
            "installed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "utility_installed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "running": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "runtime_directory": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "accessible": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "version": {
              "type": "string",
              "maxLength": 4096
            },
            "utility_path": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "additionalProperties": false
        },
        "cgroups": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "v1",
                "v2",
                "mixed",
                "unavailable",
                "unknown"
              ]
            },
            "memberships": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "hierarchy": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "controllers": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 4096
                  }
                },
                "additionalProperties": false
              }
            },
            "mounts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "root": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "type": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "controller_path": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "controllers": {
                    "type": [
                      "array",
                      "null"
                    ],
