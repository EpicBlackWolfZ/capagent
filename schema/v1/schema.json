{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EpicBlackWolfZ/capagent/schema/v1/schema.json",
  "title": "CapagentReportV1",
  "description": "Authoritative machine-readable report format for container host compatibility evaluations (Schema v1).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "context",
    "host",
    "runtimes",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Canonical schema major version integer (fixed to 1 for Schema v1)."
    },
    "context": {
      "type": "object",
      "description": "Evaluation execution context summarizing target user identity and environment boundaries.",
      "additionalProperties": true,
      "required": [
        "uid",
        "gid",
        "target_user",
        "is_rootless",
        "in_container"
      ],
      "properties": {
        "uid": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Target Linux User ID (UID) under which capability evaluations are assessed.",
          "minimum": 0,
          "maximum": 4294967295
        },
        "gid": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Target Linux Group ID (GID) under which capability evaluations are assessed.",
          "minimum": 0,
          "maximum": 4294967295
        },
        "target_user": {
          "type": "string",
          "description": "Target Linux username for deployment."
        },
        "is_rootless": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether evaluations execute under non-root unprivileged namespace constraints."
        },
        "in_container": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the evaluation environment is itself running within an outer container."
        },
        "completeness": {
          "$ref": "#/$defs/completeness"
        }
      }
    },
    "host": {
      "type": "object",
      "description": "Observed host-level kernel, distribution, cgroup, and init system facts.",
      "additionalProperties": true,
      "required": [
        "os",
        "os_version",
        "kernel",
        "architecture",
        "cgroup_version",
        "systemd"
      ],
      "properties": {
        "os": {
          "type": "string",
          "description": "Normalized operating system ID (e.g. rhel, fedora, ubuntu, debian, alpine)."
        },
        "os_version": {
          "type": "string",
          "description": "Operating system release version string."
        },
        "kernel": {
          "type": "string",
          "description": "Operating system kernel release string (uname -r)."
        },
        "architecture": {
          "type": "string",
          "description": "Host hardware architecture (e.g. x86_64, aarch64, arm64)."
        },
        "cgroup_version": {
          "type": "string",
          "enum": [
            "v1",
            "v2",
            "mixed",
            "unavailable",
            "unknown"
          ],
          "description": "Cgroup hierarchy operational mode on the host."
        },
        "systemd": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether systemd init is active as PID 1 on the host."
        },
        "completeness": {
          "$ref": "#/$defs/completeness"
        }
      }
    },
    "runtimes": {
      "type": "object",
      "description": "Observed container runtimes discovered on the host environment.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "installed": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the runtime executable exists on host PATH or standard locations."
          },
          "version": {
            "type": "string",
            "description": "Reported version string of the runtime."
          },
          "accessible": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the selected runtime inspection succeeded for this evaluation scope; null means unobserved."
          },
          "network_backend": {
            "type": "string",
            "description": "Configured network backend driver (e.g. netavark, cni)."
          },
          "storage_driver": {
            "type": "string",
            "description": "Active graph/storage driver (e.g. overlay, overlay2, vfs, btrfs, zfs)."
          },
          "completeness": {
            "$ref": "#/$defs/completeness"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Evaluated canonical capabilities mapped to operational state, confidence, and evidence.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "state",
          "confidence",
          "evidence"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "supported",
              "unsupported",
              "misconfigured",
              "unavailable",
              "unknown"
            ],
            "description": "Authoritative operational capability state."
          },
          "confidence": {
            "type": "string",
            "enum": [
              "verified",
              "derived",
              "heuristic",
              "unknown"
            ],
            "description": "Degree of confidence in capability determination based on evidence hierarchy."
          },
          "reason": {
            "type": "string",
            "description": "Human-readable diagnostic reason explaining determination or root cause."
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Deterministic list of supporting evidence identifiers."
          },
          "superseded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "propertyNames": {
        "pattern": "^(host|runtime|container|image|network|storage|systemd|context)(\\.[a-z0-9_]+)+$"
      }
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    }
  },
  "$defs": {
    "completeness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unobserved"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "run_id",
        "context_id",
        "runtime",
        "endpoint"
      ]
    },
    "identity": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "uid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "gid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "supplementary_groups": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "groups_known": {
              "type": "boolean"
            }
          },
          "required": [
            "uid",
            "gid",
            "supplementary_groups",
            "groups_known"
          ]
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "namespace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "completeness": {
          "$ref": "#/$defs/completeness"
        }
      },
      "required": [
        "id",
        "source",
        "timestamp",
        "completeness"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "probe_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "completeness": {
          "$ref": "#/$defs/completeness"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "id",
        "probe_id",
        "scope",
        "timestamp",
        "completeness",
        "facts",
        "diagnostics"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "pattern": "^(host|runtime|container|image|network|storage|systemd|context)(\\.[a-z0-9_]+)+$",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "completeness": {
          "$ref": "#/$defs/completeness"
        },
        "precedence": {
          "type": "string",
          "enum": [
            "live",
            "runtime",
            "config",
            "knowledge",
            "heuristic"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "supported",
            "unsupported",
            "misconfigured",
            "unavailable",
            "unknown"
          ],
          "description": "Authoritative operational capability state."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "verified",
            "derived",
            "heuristic",
            "unknown"
          ],
          "description": "Degree of confidence in capability determination based on evidence hierarchy."
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "source",
        "claim",
        "scope",
        "timestamp",
        "completeness",
        "precedence",
        "state",
        "confidence",
        "observations",
        "depends_on"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "SATISFIED",
            "UNSATISFIED",
            "INDETERMINATE"
          ]
        },
        "reason": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      },
      "required": [
        "state",
        "reason",
        "diagnostics",
        "children"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "const": "fixture"
        },
        "provenance": {
          "type": "string",
          "enum": [
            "captured",
            "synthetic"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "current": {
          "$ref": "#/$defs/identity"
        },
        "target": {
          "$ref": "#/$defs/identity"
        },
        "namespaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namespace"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "requirement": {
          "$ref": "#/$defs/requirement"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "mode",
        "provenance",
        "scope",
        "timestamp",
        "current",
        "target",
        "namespaces",
        "observations",
        "evidence",
        "requirement",
        "diagnostics"
      ]
    }
  }
}
